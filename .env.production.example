# Production environment template — placeholders only. Never commit real values.
#
# Copy this file to the hosting dashboard's environment configuration. The local
# `.env` file is for SQLite / polling development only.
#
# Secret handling:
#   * VERCEL: mark BOT_TOKEN, DATABASE_URL and TELEGRAM_WEBHOOK_SECRET as
#     Sensitive / Secret environment variables.
#   * GITHUB ACTIONS: store TELEGRAM_BOT_TOKEN and DATABASE_URL as repository
#     secrets; store OWNER_IDS as a repository variable. The worker maps the
#     TELEGRAM_BOT_TOKEN secret to the runtime BOT_TOKEN variable.
#   * Never print these files, environment dumps, `DATABASE_URL`, or bot tokens
#     in CI logs.

# ---------------------------------------------------------------------------
# Sensitive secrets
# ---------------------------------------------------------------------------

# BotFather token. BOT_TOKEN is the canonical runtime name.
# Settings accepts TELEGRAM_BOT_TOKEN as an alias, so a dashboard secret named
# TELEGRAM_BOT_TOKEN can be exposed to the process as BOT_TOKEN.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# Supabase transaction-pooler DSN for the runtime role (port 6543).
# Shape: postgresql://RUNTIME_ROLE.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://REPLACE_RUNTIME_ROLE.REPLACE_PROJECT_REF:REPLACE_PASSWORD@REPLACE_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Telegram webhook secret header value (1-256 characters: A-Z a-z 0-9 _ -).
# Required only by the Vercel webhook runtime. Generate a random value locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS

# ---------------------------------------------------------------------------
# Shared non-sensitive configuration
# ---------------------------------------------------------------------------

# PostgreSQL is mandatory for Vercel and the GitHub Actions worker.
DATABASE_BACKEND=postgres

# SSL: the DSN's sslmode=require is authoritative. DB_SSL is used only when the
# DSN does not carry an sslmode parameter.
DB_SSL=require

# Transaction-pooler safety. 0 disables prepared-statement caching.
DB_STATEMENT_CACHE_SIZE=0

# Pool budget per process. Vercel should use 1 (many warm instances x 1 client).
# The single GitHub Actions worker may use 2.
DB_POOL_MIN=0
DB_POOL_MAX=1

DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

# Comma-separated numeric Telegram user IDs seeded into the admins table.
OWNER_IDS=REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID

# Scheduler timezone and daily publishing time. The GitHub Actions cron is UTC
# (20:00 IST = 14:30 UTC); these values drive reports and catch-up dates.
TIMEZONE=Asia/Kolkata
PUBLISH_HOUR=20
PUBLISH_MINUTE=0

# Per-destination batch and Telegram pacing. Keep the conservative defaults.
DEFAULT_BATCH_SIZE=100
MAX_BATCH_SIZE=1000
PUBLISH_CHUNK_SIZE=100
SEND_DELAY_SECONDS=3.0
CHUNK_DELAY_SECONDS=2.0
MAX_SEND_RETRIES=3
SEND_RETRY_BACKOFF_SECONDS=2.0
MAX_CATCHUP_CYCLES=7

# Logging. Vercel's project filesystem is read-only; leave LOG_FILE empty and
# use the platform log viewer. The local fallback path is shown for reference.
LOG_LEVEL=INFO
LOG_FILE=

# No process may start APScheduler in production. The webhook enqueues requests
# and the GitHub Actions worker performs the bounded publishing pass.
SCHEDULER_ENABLED=false
CATCHUP_ON_STARTUP=false

# Owner reports are useful and remain enabled. The Vercel handlers use them;
# the worker does not send per-run reports.
ADMIN_REPORTS=true

# ---------------------------------------------------------------------------
# SQLite rollback only (ignored when DATABASE_BACKEND=postgres)
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/bot.db
