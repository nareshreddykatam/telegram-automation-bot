# Template only. Do not copy this file into `.github/workflows/` until the
# deployment checklist has been completed and the action SHAs have been
# re-verified against the official release tags.
#
# Activation:
#   Copy-Item deployment\worker.yml.template .github\workflows\publishing-worker.yml
#   git add .github/workflows/publishing-worker.yml
#   git commit -m "Activate production publishing worker"
#   git push
#
# Required repository configuration:
#   Secret   TELEGRAM_BOT_TOKEN  BotFather token
#   Secret   DATABASE_URL        Supabase transaction-pooler DSN
#   Variable OWNER_IDS           Numeric Telegram owner IDs
#
# The schedule is UTC. 14:30 UTC = 20:00 Asia/Kolkata (IST has no DST).
#
# Action pins are official release commits. Because this preparation phase was
# not allowed to access GitHub remotely, re-verify them before activation:
#   git ls-remote https://github.com/actions/checkout refs/tags/v4.2.2
#   git ls-remote https://github.com/actions/setup-python refs/tags/v5.6.0
# Replace the SHA if the tag no longer resolves to the commit below.

name: Publishing worker

on:
  schedule:
    - cron: "30 14 * * *"
  workflow_dispatch:
    inputs:
      confirm:
        description: Type "run" to confirm a manual publishing pass
        required: true
        default: ""
        type: string

permissions:
  contents: read

concurrency:
  group: telegram-publishing-worker
  cancel-in-progress: false

jobs:
  worker:
    if: >-
      github.event_name == 'schedule' ||
      github.event.inputs.confirm == 'run'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Check out repository
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install runtime dependencies
        run: python -m pip install --disable-pip-version-check -r requirements.txt

      - name: Run one bounded worker pass
        env:
          # Runtime name expected by app.config.Settings.
          BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          OWNER_IDS: ${{ vars.OWNER_IDS }}
          DATABASE_BACKEND: postgres
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          DB_SSL: require
          DB_POOL_MIN: "0"
          DB_POOL_MAX: "2"
          DB_STATEMENT_CACHE_SIZE: "0"
          DB_COMMAND_TIMEOUT_SECONDS: "30"
          DB_CONNECT_TIMEOUT_SECONDS: "10"
          LOG_LEVEL: INFO
          LOG_FILE: ""
          SCHEDULER_ENABLED: "false"
          CATCHUP_ON_STARTUP: "false"
          TIMEZONE: Asia/Kolkata
          PUBLISH_HOUR: "20"
          PUBLISH_MINUTE: "0"
          DEFAULT_BATCH_SIZE: "100"
          MAX_BATCH_SIZE: "1000"
          PUBLISH_CHUNK_SIZE: "100"
          SEND_DELAY_SECONDS: "3.0"
          CHUNK_DELAY_SECONDS: "2.0"
          MAX_SEND_RETRIES: "3"
          SEND_RETRY_BACKOFF_SECONDS: "2.0"
          MAX_CATCHUP_CYCLES: "7"
          ADMIN_REPORTS: "true"
        run: python -m app.worker
