# Copy this file to .env and fill in real values. Never commit .env.
# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-real-token

# Comma-separated Telegram numeric user IDs allowed to use admin commands.
# The bot refuses to start when this is empty.
OWNER_IDS=123456789

# Persistent SQLite file. Use an absolute path in production if you prefer.
DATABASE_PATH=data/bot.db

# Scheduler timezone and daily publishing time (24h clock).
TIMEZONE=Asia/Kolkata
PUBLISH_HOUR=20
PUBLISH_MINUTE=0

# Default per-destination batch size when /adddest does not specify one.
DEFAULT_BATCH_SIZE=100
MAX_BATCH_SIZE=1000

# Publishing safety controls.
# Chunk size is the number of messages processed before a short pause.
PUBLISH_CHUNK_SIZE=100
# Seconds to wait between Telegram copy calls. 3s is deliberately conservative.
SEND_DELAY_SECONDS=3.0
# Seconds to wait between chunks.
CHUNK_DELAY_SECONDS=2.0
# Retries for transient failures/flood waits before a batch stops and resumes later.
MAX_SEND_RETRIES=3
SEND_RETRY_BACKOFF_SECONDS=2.0

# Logging
LOG_LEVEL=INFO
# Leave empty to log to console only.
LOG_FILE=logs/bot.log

# Scheduler behaviour
SCHEDULER_ENABLED=true
CATCHUP_ON_STARTUP=true
# On restart, process at most this many missed daily batches per destination.
# Remaining messages stay queued and publish in later daily batches.
MAX_CATCHUP_CYCLES=7

# Send scheduled/manual publishing reports to owner IDs.
ADMIN_REPORTS=true
